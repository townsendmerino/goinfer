{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|EnterWorktree",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/go/bin/claude-guard\"",
            "timeout": 10,
            "statusMessage": "claude-guard: checking the call against the repo rules"
          }
        ]
      }
    ]
  }
}
