package fixture

import (
	"reflect"
	"testing"
)

func TestParse(t *testing.T) {
	got, err := Parse("1, 2,3,")
	if err != nil {
		t.Fatal(err)
	}
	if want := []int{1, 2, 3}; !reflect.DeepEqual(got, want) {
		t.Fatalf("Parse = %v, want %v", got, want)
	}
	if _, err := Parse("1,x"); err == nil {
		t.Fatal("Parse(\"1,x\") returned no error")
	}
}
