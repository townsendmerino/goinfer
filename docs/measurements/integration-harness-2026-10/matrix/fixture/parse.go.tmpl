package fixture

import (
	"fmt"
	"strconv"
	"strings"
)

// Parse reads a comma-separated list of integers. Blanks around a number and empty fields are ignored.
func Parse(s string) ([]int, error) {
	var out []int
	for _, f := range strings.Split(s, ",") {
		f = strings.TrimSpace(f)
		if f == "" {
			continue
		}
		n, err := strconv.Atoi(f)
		if err != nil {
			return nil, fmt.Errorf("parse %q: %w", f, err)
		}
		out = append(out, n)
	}
	return out, nil
}
