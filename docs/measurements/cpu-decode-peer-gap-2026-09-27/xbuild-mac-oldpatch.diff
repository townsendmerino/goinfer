package decoder

import "os"

// L1 Mac cross-build MEASUREMENT PATCH — never committed. The old build's GOINFER_INT4_F16_SCALES
// diagnostic reaches only the quantize-from-f32 paths (weightmat.go), not the .giw reader, so an old
// build loading a .giw runs f32 scales whatever the env says. This routes the reader's aliased int4
// scale arrays through the diagnostic's own f16RoundF32 (element-wise, so the row4 scale interleave
// does not matter) when the env is set, making the old build carry the f16-rounded weights the new
// build converts to at read.
func l1RoundGIWScales(s []float32) []float32 {
	if os.Getenv("GOINFER_INT4_F16_SCALES") == "" {
		return s
	}
	out := make([]float32, len(s))
	for i, v := range s {
		out[i] = f16RoundF32(v)
	}
	return out
}
