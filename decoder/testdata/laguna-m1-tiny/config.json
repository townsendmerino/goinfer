{
  "architectures": [
    "LagunaForCausalLM"
  ],
  "attention_bias": false,
  "attention_dropout": 0.0,
  "auto_map": {
    "AutoConfig": "configuration_laguna.LagunaConfig",
    "AutoModelForCausalLM": "modeling_laguna.LagunaForCausalLM"
  },
  "decoder_sparse_step": 1,
  "dtype": "float32",
  "gating": "per-element",
  "head_dim": 16,
  "hidden_act": "silu",
  "hidden_size": 64,
  "initializer_range": 0.02,
  "intermediate_size": 128,
  "layer_types": [
    "full_attention",
    "full_attention",
    "full_attention",
    "full_attention"
  ],
  "max_position_embeddings": 512,
  "mlp_layer_types": [
    "dense",
    "dense",
    "sparse",
    "sparse"
  ],
  "mlp_only_layers": [
    0,
    1
  ],
  "model_type": "laguna",
  "moe_apply_router_weight_on_input": false,
  "moe_intermediate_size": 32,
  "moe_routed_scaling_factor": 1.0,
  "moe_router_logit_softcapping": 0.0,
  "norm_topk_prob": true,
  "num_attention_heads": 4,
  "num_attention_heads_per_layer": null,
  "num_experts": 8,
  "num_experts_per_tok": 2,
  "num_hidden_layers": 4,
  "num_key_value_heads": 2,
  "output_router_logits": false,
  "partial_rotary_factor": null,
  "qkv_bias": false,
  "rms_norm_eps": 1e-06,
  "rope_parameters": {
    "full_attention": {
      "beta_fast": 64.0,
      "beta_slow": 1.0,
      "factor": 64.0,
      "original_max_position_embeddings": 128,
      "partial_rotary_factor": 1.0,
      "rope_theta": 500000.0,
      "rope_type": "yarn"
    },
    "rope_theta": 10000.0,
    "rope_type": "default"
  },
  "router_aux_loss_coef": 0.0,
  "shared_expert_intermediate_size": 32,
  "sliding_window": 0,
  "swa_attention_sink_enabled": false,
  "swa_rope_parameters": null,
  "tie_word_embeddings": false,
  "transformers_version": "5.12.0",
  "use_cache": true,
  "vocab_size": 256
}
