# Editor / agent local config (per-user, never committed)
.claude/settings.local.json

# Build artifacts
/dist/
/bin/
demo/chat/dist/
# Embedded demo model asset (build input, generated by demo/chat/build-embed.sh)
*.zst
*.giw

# Model weights — large, supplied per-machine, never committed.
# Tests skip cleanly when these aren't present.
*.safetensors
*.gguf
*.bin
# EXCEPTION: mixtral-tiny is a 3.6 MB deterministic random-weight MoE checkpoint
# (scripts/pin_mixtral_tiny.py). Committed on purpose so the MoE parity gate is a
# real T1 — runnable in CI without a per-machine asset — rather than a golden that
# skips because its checkpoint is gitignored. See docs/parity-coverage-policy.md,
# "A gate must be able to run, and able to fail".
!testdata/mixtral-tiny/
!testdata/mixtral-tiny/model.safetensors
# EXCEPTION: cohere-tiny + cohere2-tiny are 656 KB deterministic random-weight
# checkpoints (scripts/pin_cohere_tiny.py, scripts/pin_cohere2_tiny.py). Committed on
# purpose so the Cohere / Command-R (v1 + v2) forward-parity gates are real T1s —
# runnable in CI without a per-machine asset — rather than goldens that skip because
# their checkpoint is gitignored. Same rationale as mixtral-tiny above; see
# docs/parity-coverage-policy.md, "A gate must be able to run, and able to fail".
!testdata/cohere-tiny/
!testdata/cohere-tiny/model.safetensors
!testdata/cohere2-tiny/
!testdata/cohere2-tiny/model.safetensors

# EXCEPTION: the DFlash reference trace (2.6 MB, scripts/pin_dflash_trace.py). It is the
# upstream implementation's OWN per-layer output, not weights — the oracle P10's kill-gate 1
# compares against. Regenerating it costs ~24 GB of downloads plus a torch run, so it is
# committed. NOTE this does NOT make the gate CI-runnable: TestDFlash_referenceParity also
# needs the drafter weights (GOINFER_DFLASH_F32, 2.1 GB) and skips without them, so it is
# T3-in-practice — labelled as such per docs/parity-coverage-policy.md.
!testdata/dflash_qwen3_4b_ref.safetensors
!testdata/dspark_qwen3_4b_ref.safetensors
# EXCEPTION: glm-tiny.gguf is an 812 KB SYNTHETIC GGUF — scripts/pin_glm_tiny.py builds a
# randomly-initialized Glm4MoeForCausalLM from a config (vocab 256, hidden 64, 3 layers; no real
# GLM weights are copied, so no licensing question), and scripts/pin_glm_tiny_gguf.py converts it.
# Committed on purpose: while it was gitignored, TestStreamTranscodeMatchesResident and the .giw
# round-trip gates SELF-SKIPPED in CI and had never run there — so the .giw v5 quant-label change
# (ac6977f) silently invalidated the byte-identity assertion and shipped in v0.10.2 with nothing
# red. Same rationale as mixtral-tiny/cohere-tiny above; see docs/parity-coverage-policy.md,
# "A gate must be able to run, and able to fail".
!testdata/glm-tiny.gguf
testdata/model
testdata/models
testdata/*-gguf
testdata/*-sharded
# downloaded quantized HF checkpoints for the GPTQ/AWQ parity gates (~0.8 GB each)
testdata/*-gptq
testdata/*-awq
# generated tiny qwen3_5_moe parity checkpoint (scripts/pin_qwen35_forward.py)
testdata/qwen35-tiny/
# generated tiny/scaled parity checkpoints — weights are *.safetensors (ignored above), but the
# tokenizer/config JSONs are not, so ignore the whole dirs; the *_golden.json in testdata/ stay tracked.
testdata/tiny-qwen2-moe/
# Per-machine real-checkpoint fixtures for the §C1 sweep's forward-parity and tokenizer gates.
# Same class as the dirs above: regenerable/fetchable locally, never committed. Listed because
# these gates skip without them, and a skip in that sweep is a release blocker — so the dirs get
# created on any box that runs it, and an unignored fixture dir is how generated metadata gets
# swept into a commit and turns CI red.
# NO trailing slash on purpose: on a box that satisfies these from ~/models they are
# SYMLINKS, and git treats a symlink as a file — a "dir/" pattern silently fails to match
# it, leaving exactly the untracked fixture entry this block exists to prevent.
testdata/qwen2.5-0.5b
testdata/qwen3-1.7b
testdata/tinyllama-1.1b
testdata/tinymistral-248m
testdata/llama3.2-1b
testdata/gemma-3-270m
testdata/gpt2
testdata/llama3-tokenizer
testdata/mellum2-tokenizer
testdata/gemma4-dense-scaled-*/
# generated tiny vision-language parity checkpoints (scripts/pin_siglip_vision.py,
# scripts/pin_gemma3_vl_tiny.py) — regenerated locally; the *_golden.json stay tracked.
testdata/siglip-tiny/
testdata/gemma3-vl-tiny/
testdata/qwen25vl-tiny/
# full-logit cosine dumps for the forward-parity gates — large, regenerated by the pin
# scripts (the partial *_forward_golden.json stay tracked; cosine skips when absent).
testdata/*_forward_full.json

# Full-logit / parity dumps — per-machine, regenerated by scripts/.
# The small committed golden fixtures (gemma_*_golden.json, etc.) stay tracked;
# the multi-MB *_full.json dumps and layer-trace harness outputs do not.
testdata/*_full.json
testdata/*_trace.json
testdata/parity.jsonl

# Go
*.test
*.out
/vendor/
go.work
go.work.sum

# Python tooling (golden-fixture regeneration harnesses)
.venv/
__pycache__/
*.pyc

# Editor / OS
.DS_Store
.vscode/
.idea/
*.swp

# Internal docs — sprint scratchpads, planning, strategy. Public repo, so the
# whole dir stays local ("internal" by name, not by visibility). Cross-machine
# docs (gpu-assessment.md, the deferred task-*.md plans) live in docs/ proper.
docs/internal/

# Stray binaries from `go build ./cmd/...` in the repo root
/serve

# stray go-build binaries at repo root
/prequant
/spikeembed
/spikeq6k
testdata/glm-tiny/
testdata/glm-tiny-bias/
testdata/granite-tiny/
testdata/nemotron-tiny/
testdata/nemotron3nano-tiny/
testdata/qwen3next-tiny/
testdata/deepseek-tiny/
testdata/phi3-tiny/
testdata/kimi-tiny/
testdata/llama4-tiny/
# testdata/mixtral-tiny/ is intentionally committed — see the exception near the top
# of this file and docs/parity-coverage-policy.md (the MoE parity gate must be a real T1).

# gpt-oss real-model HF logit golden (2 MB; regenerate via scripts/gptoss_hf_oracle.py)
decoder/testdata/gptoss_20b_golden.json

# generated tiny gemma4 parity checkpoints (scripts/pin_gemma4_*.py); golden JSON stays tracked
testdata/gemma4-moe-tiny/
testdata/gemma4-moe-kv-tiny/
testdata/gemma4-moe-unified-tiny/
testdata/gemma4-dense-twogeom-tiny/
testdata/gemma4-dense-scaled/

# Generated scaled MoE fixture (1.9 GB): weights AND config JSONs stay out of git.
# Committing the JSONs alone would make the directory "exist" for a dir-only skip guard while
# holding no model — turning a clean skip into a CI failure (see loadG4MoECache).
testdata/gemma4-moe-scaled/

# Laguna (G6) tiny fixtures. The WEIGHTS and config.json are tracked (they are
# ~1.3MB each and goinfer's loader reads only those, so the T1 gate runs in CI
# like mixtral-tiny's does). poolside's vendored modeling_laguna.py /
# configuration_laguna.py are NOT redistributed — they are fetched on demand by
# scripts/pin_laguna_tiny.py, which is the only thing that needs them.
decoder/testdata/.laguna-code-*/
decoder/testdata/laguna-*-tiny/*.py
!decoder/testdata/laguna-xs21-tiny/model.safetensors
!decoder/testdata/laguna-xs2-tiny/model.safetensors
!decoder/testdata/laguna-m1-tiny/model.safetensors

# Laguna real-weight SLICE fixtures (scripts/pin_laguna_slice.py). ~6GB each: real
# checkpoint layers, regenerable from a local XS.2/XS-2.1 copy. Only the goldens
# (decoder/testdata/laguna_*_slice_golden.json) are tracked — unlike the ~1.3MB tiny
# fixtures, these are far too large to ship, so the slice gates skip without them.
decoder/testdata/laguna-*-slice/
decoder/testdata/qwen3next-*-slice/
decoder/testdata/gptoss120-slice/
