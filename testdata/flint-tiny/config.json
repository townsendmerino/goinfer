{
  "architectures": [
    "FlintForCausalLM"
  ],
  "model_type": "flint",
  "vocab_size": 256,
  "hidden_size": 64,
  "intermediate_size": 128,
  "num_hidden_layers": 6,
  "num_attention_heads": 4,
  "num_key_value_heads": 2,
  "head_dim": 16,
  "hidden_act": "silu",
  "max_position_embeddings": 2048,
  "initializer_range": 0.02,
  "rms_norm_eps": 1e-06,
  "use_cache": true,
  "tie_word_embeddings": false,
  "rope_theta": 10000.0,
  "use_sliding_window": true,
  "sliding_window": 8,
  "attention_bias": false,
  "attention_dropout": 0.0,
  "attention_sink": true,
  "softmax_type": "learnable",
  "decoder_sparse_step": 1,
  "moe_intermediate_size": 32,
  "shared_expert_intermediate_size": 32,
  "num_experts": 8,
  "num_local_experts": 8,
  "num_experts_per_tok": 2,
  "norm_topk_prob": true,
  "router_score_function": "sigmoid",
  "router_expert_bias": false,
  "mlp_only_layers": [
    0,
    1
  ],
  "layer_types": [
    "full_attention",
    "full_attention",
    "sliding_attention",
    "sliding_attention",
    "sliding_attention",
    "full_attention"
  ],
  "no_rope_layer_indices": [
    0,
    1,
    5
  ],
  "bos_token_id": 1,
  "eos_token_id": [
    2,
    3
  ],
  "dtype": "float32"
}
