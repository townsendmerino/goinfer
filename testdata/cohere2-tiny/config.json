  "model_type": "cohere2",
  "num_attention_heads": 4,
  "num_hidden_layers": 4,
  "num_key_value_heads": 2,
  "pad_token_id": 0,
  "rope_parameters": {
    "rope_theta": 10000.0,
    "rope_type": "default"
  },
  "sliding_window": 8,
  "tie_word_embeddings": true,
  "transformers_version": "5.14.1",
  "use_cache": true,
  "vocab_size": 256
