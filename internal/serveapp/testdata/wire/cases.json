 {
  "name": "chat_tool_call",
  "about": "",
  "method": "POST",
  "path": "/v1/chat/completions",
  "body": {
   "model": "scripted",
   "max_tokens": 200,
   "tools": [
    {
     "type": "function",
     "function": {
      "name": "get_weather",
      "description": "weather for a city",
      "parameters": {
       "type": "object",
       "properties": {
        "city": {
         "type": "string"
        }
       },
       "required": [
        "city"
       ]
      }
     }
    }
   ],
   "messages": [
    {
     "role": "user",
     "content": "weather in Oslo?"
    }
   ]
  },
  "script": "<tool_call>\n{\"name\": \"get_weather\", \"arguments\": {\"city\": \"Oslo\"}}\n</tool_call>"
 },
