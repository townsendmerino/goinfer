{
  "_about": "The package layout. arrows and test_arrows: every import from one goinfer package to another, by repository-relative directory, from non-test and from test files; TestLayout_arrows fails on one the tree makes that is not here, and on one here the tree no longer makes. rules: the protected separations, which no import, made or recorded, may break; they are edited by hand only.",
  "rules": [
    {
      "name": "fit-leaf",
      "from": [
        "decoder/fit"
      ],
      "tests": true,
      "forbid_goinfer": [
        "*"
      ],
      "allow_goinfer": {
        "decoder/fit": [
          "internal/runtime/mem"
        ]
      },
      "why": "decoder/fit (Tier 3, docs/layout.md) holds the fit guard's and the planner's exchange types so a caller can name them without importing the loader. It sits below decoder, which re-exports them: it imports internal/runtime/mem and no other goinfer package, decoder included."
    },
    {
      "name": "resident-leaf",
      "from": [
        "decoder/resident"
      ],
      "tests": true,
      "forbid_goinfer": [
        "*"
      ],
      "allow_goinfer": {
        "decoder/resident": [
          "internal/cost",
          "internal/runtime/adapter"
        ]
      },
      "why": "decoder/resident holds the contract a resident backend implements (the four subsystem interfaces, the provider, ResidentForward, the drafter host and the small data their signatures carry) so a reader can hold it without the loader (MZ5 option B, docs/sub1-resident-interfaces.md). It sits below decoder, which aliases every name in decoder/residentalias.go: it imports internal/cost and internal/runtime/adapter and no other goinfer package, decoder included."
    },
    {
      "name": "config-leaf",
      "from": [
        "decoder/config"
      ],
      "tests": true,
      "forbid_goinfer": [
        "*"
      ],
      "why": "decoder/config holds a checkpoint's Config, its validators and its loader, so they test in seconds without compiling decoder. It sits below decoder, which aliases Config: it imports no goinfer package, decoder included."
    },
    {
      "name": "quant-leaf",
      "from": [
        "decoder/quant"
      ],
      "tests": true,
      "forbid_goinfer": [
        "*"
      ],
      "why": "decoder/quant (Tier 3, docs/layout.md) parses safetensors checkpoint quantization configs and reconstructs FP8, GPTQ, AWQ, NVFP4 and MLX quantized weights behind Reconstructor/RowStreamReconstructor. It sits below decoder and imports no goinfer package, decoder included."
    },
    {
      "name": "ggufconfig-leaf",
      "from": [
        "internal/runtime/ggufconfig"
      ],
      "tests": true,
      "forbid_goinfer": [
        "*"
      ],
      "allow_goinfer": {
        "internal/runtime/ggufconfig": [
          "decoder/config"
        ]
      },
      "why": "internal/runtime/ggufconfig reads a GGUF's metadata into a Config, one reader per architecture, so the readers and their fuzz target test without compiling decoder. It sits below decoder, which calls Read: it imports decoder/config and no other goinfer package, decoder included."
    },
    {
      "name": "rope-leaf",
      "from": [
        "internal/runtime/rope"
      ],
      "tests": true,
      "forbid_goinfer": [
        "*"
      ],
      "allow_goinfer": {
        "internal/runtime/rope": [
          "internal/testpath"
        ]
      },
      "why": "internal/runtime/rope holds the rotary embedding kernels (NeoX, interleaved, m-RoPE) and the rope_scaling/rope_parameters parsers with their inverse-frequency tables, so they test without compiling decoder. It sits below decoder, which calls it: it imports no goinfer package (its tests, internal/testpath)."
    },
    {
      "name": "testassets-leaf",
      "from": [
        "internal/testassets"
      ],
      "tests": true,
      "forbid_goinfer": [
        "*"
      ],
      "why": "internal/testassets resolves heavy test assets through testdata/assets.json, the one predicate for whether an asset is present. It imports no goinfer package and not testing, so a backend's tests can reach it without importing decoder."
    },
    {
      "name": "normact-leaf",
      "from": [
        "internal/runtime/normact"
      ],
      "tests": true,
      "forbid_goinfer": [
        "*"
      ],
      "why": "internal/runtime/normact holds the CPU forward's row norms and elementwise activations, so they test without compiling decoder. It sits below decoder, which calls it: it imports no goinfer package."
    },
    {
      "name": "giwcodec-leaf",
      "from": [
        "internal/runtime/giwcodec"
      ],
      "tests": true,
      "forbid_goinfer": [
        "*"
      ],
      "allow_goinfer": {
        "internal/runtime/giwcodec": [
          "decoder/arch",
          "decoder/config",
          "internal/runtime/archparts",
          "internal/runtime/families",
          "internal/runtime/program"
        ]
      },
      "why": "internal/runtime/giwcodec implements the .giw binary weight-bundle format (writer, reader, shape validator, island bf16/f32 helpers, row4 emitter, and target policy) below decoder (SZ13c). It never imports decoder."
    },
    {
      "name": "wbuild-leaf",
      "from": [
        "internal/runtime/wbuild"
      ],
      "tests": true,
      "forbid_goinfer": [
        "*"
      ],
      "allow_goinfer": {
        "internal/runtime/wbuild": [
          "decoder/arch",
          "decoder/config",
          "decoder/quant",
          "internal/runtime/archparts",
          "internal/runtime/families",
          "internal/runtime/giwcodec",
          "internal/runtime/hybridattn",
          "internal/runtime/logs"
        ]
      },
      "why": "internal/runtime/wbuild implements safetensors and GGUF weight building, quantization/row streaming, and .giw streaming sinks below decoder (SZ13b). It never imports decoder."
    },
    {
      "name": "cpuengine-leaf",
      "from": [
        "internal/runtime/cpuengine"
      ],
      "tests": true,
      "forbid_goinfer": [
        "*"
      ],
      "allow_goinfer": {
        "internal/runtime/cpuengine": [
          "decoder/arch",
          "decoder/config",
          "internal/cost",
          "internal/runtime/archparts",
          "internal/runtime/f16",
          "internal/runtime/families",
          "internal/runtime/hybridattn",
          "internal/runtime/inkling2",
          "internal/runtime/kvmgr",
          "internal/runtime/logs",
          "internal/runtime/mamba2",
          "internal/runtime/normact",
          "internal/runtime/program",
          "internal/runtime/rope",
          "internal/runtime/wbuild"
        ]
      },
      "why": "internal/runtime/cpuengine implements the CPU forward pass, KV cache, decode scratch, attention/MLP/recurrent kernels, and matmul dispatch below decoder (SZ15). It never imports decoder."
    },
    {
      "name": "families-leaf",
      "from": [
        "internal/runtime/families"
      ],
      "tests": true,
      "forbid_goinfer": [
        "*"
      ],
      "allow_goinfer": {
        "internal/runtime/families": [
          "decoder/arch",
          "decoder/config",
          "internal/runtime/archparts",
          "internal/runtime/ggufconfig",
          "internal/runtime/program",
          "internal/runtime/rope"
        ]
      },
      "why": "internal/runtime/families holds the per-family architecture adapters (arch_*.go, gemma12.go), model_type registry, and safetensors tensor schemas below decoder (SZ13a). It imports only the arch/config/rope/program/ggufconfig leaves and never decoder."
    },
    {
      "name": "arch-leaf",
      "from": [
        "decoder/arch"
      ],
      "tests": true,
      "forbid_goinfer": [
        "*"
      ],
      "allow_goinfer": {
        "decoder/arch": [
          "decoder/config",
          "internal/runtime/archparts",
          "internal/runtime/kvmgr",
          "internal/runtime/program",
          "internal/runtime/rope"
        ]
      },
      "why": "decoder/arch holds the resolved Architecture descriptor, Weights, LayerWeights and LoadProfile below decoder (SZ12 option (b)), aliased back from decoder/zz_arch_alias.go. It never imports decoder."
    },
    {
      "name": "archparts-leaf",
      "from": [
        "internal/runtime/archparts"
      ],
      "tests": true,
      "forbid_goinfer": [
        "*"
      ],
      "allow_goinfer": {
        "internal/runtime/archparts": [
          "internal/runtime/hybridattn",
          "internal/runtime/mamba2"
        ]
      },
      "why": "internal/runtime/archparts holds per-family parameter and weight structs and small internal helpers below decoder/arch (SZ12 option (b)). It imports only internal/runtime/hybridattn and internal/runtime/mamba2 and never decoder or decoder/arch."
    },
    {
      "name": "memprice-leaf",
      "from": [
        "internal/runtime/memprice"
      ],
      "tests": true,
      "forbid_goinfer": [
        "*"
      ],
      "allow_goinfer": {
        "internal/runtime/memprice": [
          "decoder/arch",
          "internal/runtime/archparts",
          "internal/runtime/kvmgr",
          "internal/runtime/mem",
          "internal/runtime/program",
          "internal/runtime/rope"
        ]
      },
      "why": "internal/runtime/memprice holds pure per-backend weight, KV, recurrent-state, scratch, and allocator byte pricing over Architecture, Weights, and program declarations below decoder. It never imports decoder or any backend."
    },
    {
      "name": "kvsnap-leaf",
      "from": [
        "internal/runtime/kvsnap"
      ],
      "tests": true,
      "forbid_goinfer": [
        "*"
      ],
      "allow_goinfer": {
        "internal/runtime/kvsnap": [
          "decoder/resident",
          "internal/runtime/kvmgr"
        ]
      },
      "why": "internal/runtime/kvsnap manages GPU-to-host prefix KV snapshots, LRU byte budgets (resident.KVHostBudget), candidate matching, and boundary/recurrent cut planning below decoder. It imports only decoder/resident and internal/runtime/kvmgr and never decoder."
    },
    {
      "name": "paging-leaf",
      "from": [
        "internal/runtime/paging"
      ],
      "tests": true,
      "forbid_goinfer": [
        "*"
      ],
      "allow_goinfer": {
        "internal/runtime/paging": [
          "decoder/arch",
          "internal/runtime/logs",
          "internal/runtime/mem",
          "internal/runtime/mem/probe"
        ]
      },
      "why": "internal/runtime/paging holds MoE expert paging, the pread expert buffer pool, and dense layer paging below decoder (SZ16). It never imports decoder."
    },
    {
      "name": "blockdraft-leaf",
      "from": [
        "internal/runtime/blockdraft"
      ],
      "tests": true,
      "forbid_goinfer": [
        "*"
      ],
      "allow_goinfer": {
        "internal/runtime/blockdraft": [
          "decoder/resident",
          "internal/runtime/cpuengine",
          "internal/runtime/giwcodec",
          "internal/runtime/normact",
          "internal/runtime/rope",
          "internal/runtime/sampling",
          "internal/testassets"
        ]
      },
      "why": "internal/runtime/blockdraft holds the DFlash and DSpark block drafters, weight streaming, and resident byte estimators below decoder (SZ16). It never imports decoder."
    },
    {
      "name": "residency-leaf",
      "from": [
        "internal/runtime/residency"
      ],
      "tests": true,
      "forbid_goinfer": [
        "*"
      ],
      "allow_goinfer": {
        "internal/runtime/residency": [
          "decoder/arch",
          "decoder/resident",
          "internal/cost",
          "internal/runtime/adapter",
          "internal/runtime/kvmgr",
          "internal/runtime/kvsnap"
        ]
      },
      "why": "internal/runtime/residency holds resident subsystem resolution, KV scope, the resident decode batcher, slot reuse/sharing, host snapshot orchestration, and recurrent checkpoints below decoder (SZ16). It never imports decoder."
    },
    {
      "name": "sidecar-leaf",
      "from": [
        "internal/runtime/sidecar"
      ],
      "tests": true,
      "forbid_goinfer": [
        "*"
      ],
      "allow_goinfer": {
        "internal/runtime/sidecar": [
          "internal/runtime/giw",
          "internal/runtime/giwcodec",
          "internal/runtime/logs",
          "internal/runtime/wbuild",
          "tokenizer"
        ]
      },
      "why": "internal/runtime/sidecar holds .giw sidecar transcoding, GGUF metadata extraction, projected and LoRA sidecars, and readback helpers below decoder (SZ16). It never imports decoder."
    },
    {
      "name": "specdecode-leaf",
      "from": [
        "internal/runtime/specdecode"
      ],
      "tests": true,
      "forbid_goinfer": [
        "*"
      ],
      "allow_goinfer": {
        "internal/runtime/specdecode": [
          "constrain",
          "decoder/arch",
          "decoder/resident",
          "internal/runtime/program",
          "internal/runtime/sampling"
        ]
      },
      "why": "internal/runtime/specdecode holds speculative decoding drafters, trace collection, adaptive depth, optimistic-forward overlap, and verification loops below decoder (SZ16). It never imports decoder."
    },
    {
      "name": "towers-standalone",
      "from": [
        "internal/vision",
        "internal/audio"
      ],
      "tests": true,
      "forbid_goinfer": [
        "*"
      ],
      "allow_goinfer": {
        "internal/audio": [
          "internal/vision"
        ]
      },
      "allow_external": [
        "github.com/townsendmerino/aikit/linalg",
        "github.com/townsendmerino/aikit/embed"
      ],
      "why": "The towers moved from aikit (AX) as model semantics over aikit's kernels: no goinfer package, and from outside the standard library only aikit's linalg and embed. One exception: internal/audio may import internal/vision, whose tower program type the audio towers walk (Francis, 2026-10-29)."
    },
    {
      "name": "gpudev-standalone",
      "from": [
        "backend/cuda/internal/gpudev",
        "backend/metal/internal/gpudev"
      ],
      "tests": true,
      "forbid_goinfer": [
        "*"
      ],
      "why": "The device substrate (AX) sits under every backend package and imports none of them, nor anything else of goinfer's."
    },
    {
      "name": "kernels-free-of-decoder",
      "from": [
        "backend/cuda/kernels",
        "backend/metal/kernels",
        "backend/webgpu/internal/kernels"
      ],
      "tests": true,
      "forbid_goinfer": [
        "decoder"
      ],
      "why": "Backend kernel tests left the packages that import decoder (SB1 step 1) so a decoder edit stops re-running them."
    },
    {
      "name": "probe-standalone",
      "from": [
        "internal/runtime/mem/probe"
      ],
      "tests": true,
      "forbid_goinfer": [
        "*"
      ],
      "why": "The one reader of the OS's memory account (MM0) imports no goinfer package; that it is the only reader is TestOnlyProbeReadsOSMemory."
    },
    {
      "name": "root-free-of-backends",
      "from": [
        "module:root"
      ],
      "tests": true,
      "forbid_goinfer": [
        "backend/cuda",
        "backend/metal",
        "backend/webgpu"
      ],
      "forbid_external": [
        "github.com/townsendmerino/aikit/gpu",
        "github.com/ebitengine/purego",
        "github.com/eitamring/gocudrv"
      ],
      "gomod_forbid": [
        "github.com/townsendmerino/goinfer/backend/cuda",
        "github.com/townsendmerino/goinfer/backend/metal",
        "github.com/townsendmerino/goinfer/backend/webgpu",
        "github.com/townsendmerino/aikit/gpu",
        "github.com/ebitengine/purego",
        "github.com/eitamring/gocudrv"
      ],
      "why": "The root module builds without a GPU toolchain or binding: the backends are their own modules, which import the root, never the reverse."
    },
    {
      "name": "scheduler-standard-library",
      "from": [
        "internal/runtime/scheduler"
      ],
      "tests": true,
      "forbid_goinfer": [
        "*"
      ],
      "std_only": true,
      "why": "The scheduling policy (SB6) is decisions over plain values: no goinfer package and nothing outside the standard library, so it can be tested on a virtual clock with nothing loaded."
    },
    {
      "name": "engine-below-the-shell",
      "from": [
        "engine",
        "engine/enginetest"
      ],
      "tests": true,
      "forbid_goinfer": [
        "internal/app/serveapp",
        "internal/app/chatapp",
        "cmd"
      ],
      "why": "The engine package (SB7) is what the serving shell asks of a model; the shell imports it and its fakes, never the reverse, so a fake engine needs no server."
    },
    {
      "name": "serveapp-fakes-test-only",
      "from": [
        "internal/app/serveapp"
      ],
      "tests": false,
      "forbid_goinfer": [
        "engine/enginetest"
      ],
      "why": "The engine fakes are test code: the serving shell's production files do not link them. A test supplies its engine through loadedModel.fakeEngine."
    },
    {
      "name": "serveapp-stores-leaf",
      "from": [
        "internal/app/serveapp/stores"
      ],
      "tests": true,
      "forbid_goinfer": [
        "*"
      ],
      "allow_goinfer": {
        "internal/app/serveapp/stores": [
          "internal/app/serveapp/jobs",
          "internal/batchio"
        ]
      },
      "why": "internal/app/serveapp/stores holds the bounded in-memory serving stores (FileStore, BatchStore, GenerationRegistry, FeatureCache, ResponseStore) below serveapp (SA1). It imports only internal/app/serveapp/jobs and internal/batchio and never decoder or serveapp."
    },
    {
      "name": "serveapp-streamframe-leaf",
      "from": [
        "internal/app/serveapp/streamframe"
      ],
      "tests": true,
      "forbid_goinfer": [
        "*"
      ],
      "allow_goinfer": {
        "internal/app/serveapp/streamframe": [
          "chat",
          "internal/app/serveapp/carriedids",
          "internal/codec"
        ]
      },
      "why": "internal/app/serveapp/streamframe holds SSE transport, thinking-block splitting, reasoning-token budget resolution, /v1/responses reasoning items, and Responses/Anthropic stream state machines below serveapp (SA2). It never imports decoder or serveapp."
    }
  ],
