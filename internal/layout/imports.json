{
  "_about": "SB13's package layout (docs/tasks/task-subsystems-2026-10.md §8 and §9). arrows and test_arrows: every import from one goinfer package to another, by repository-relative directory, from non-test and from test files; TestLayout_arrows fails on one the tree makes that is not here, and on one here the tree no longer makes. rules: the protected separations, which no import, made or recorded, may break; they are edited by hand only.",
  "rules": [
    {
      "name": "towers-standalone",
      "from": [
        "internal/vision",
        "internal/audio"
      ],
      "tests": true,
      "forbid_goinfer": [
        "*"
      ],
      "allow_goinfer": {
        "internal/audio": [
          "internal/vision"
        ]
      },
      "allow_external": [
        "github.com/townsendmerino/aikit/linalg",
        "github.com/townsendmerino/aikit/embed"
      ],
      "why": "The towers moved from aikit (AX) as model semantics over aikit's kernels: no goinfer package, and from outside the standard library only aikit's linalg and embed. One exception: internal/audio may import internal/vision, whose tower program type the audio towers walk (Francis, 2026-10-29)."
    },
    {
      "name": "gpudev-standalone",
      "from": [
        "backend/cuda/internal/gpudev",
        "backend/metal/internal/gpudev"
      ],
      "tests": true,
      "forbid_goinfer": [
        "*"
      ],
      "why": "The device substrate (AX) sits under every backend package and imports none of them, nor anything else of goinfer's."
    },
    {
      "name": "kernels-free-of-decoder",
      "from": [
        "backend/cuda/kernels",
        "backend/metal/kernels",
        "backend/webgpu/internal/kernels"
      ],
      "tests": true,
      "forbid_goinfer": [
        "decoder"
      ],
      "why": "Backend kernel tests left the packages that import decoder (SB1 step 1) so a decoder edit stops re-running them."
    },
    {
      "name": "probe-standalone",
      "from": [
        "internal/mem/probe"
      ],
      "tests": true,
      "forbid_goinfer": [
        "*"
      ],
      "why": "The one reader of the OS's memory account (MM0) imports no goinfer package; that it is the only reader is TestOnlyProbeReadsOSMemory."
    },
    {
      "name": "root-free-of-backends",
      "from": [
        "module:root"
      ],
      "tests": true,
      "forbid_goinfer": [
        "backend/cuda",
        "backend/metal",
        "backend/webgpu"
      ],
      "forbid_external": [
        "github.com/townsendmerino/aikit/gpu",
        "github.com/ebitengine/purego",
        "github.com/eitamring/gocudrv"
      ],
      "gomod_forbid": [
        "github.com/townsendmerino/goinfer/backend/cuda",
        "github.com/townsendmerino/goinfer/backend/metal",
        "github.com/townsendmerino/goinfer/backend/webgpu",
        "github.com/townsendmerino/aikit/gpu",
        "github.com/ebitengine/purego",
        "github.com/eitamring/gocudrv"
      ],
      "why": "The root module builds without a GPU toolchain or binding: the backends are their own modules, which import the root, never the reverse."
    },
    {
      "name": "scheduler-standard-library",
      "from": [
        "internal/scheduler"
      ],
      "tests": true,
      "forbid_goinfer": [
        "*"
      ],
      "std_only": true,
      "why": "The scheduling policy (SB6) is decisions over plain values: no goinfer package and nothing outside the standard library, so it can be tested on a virtual clock with nothing loaded."
    },
    {
      "name": "engine-below-the-shell",
      "from": [
        "engine",
        "engine/enginetest"
      ],
      "tests": true,
      "forbid_goinfer": [
        "internal/serveapp",
        "internal/chatapp",
        "cmd"
      ],
      "why": "The engine package (SB7) is what the serving shell asks of a model; the shell imports it and its fakes, never the reverse, so a fake engine needs no server."
    }
  ],
