# Hand-formatted "%.Nf GB" sites (TestQualityScan_memorySizesUseTheGiBFormatter): `<file> <ceiling> -- <reason>`.
# Disk and download sizes stay SI.
cmd/gate/identity_giw.go 1 -- a checkpoint's size on disk
decoder/coldload.go 1 -- a checkpoint's size on disk, read once before the load
decoder/arch/loadprofile.go 2 -- bytes read from disk and the read rate
decoder/sidecar.go 2 -- a sidecar's size against free disk
backend/cuda/pack_stream.go 1 -- a packed-experts file against free disk
internal/app/pullcmd/pull.go 2 -- download sizes
pull/registry.go 1 -- download sizes
# Memory sizes still formatted by hand: the swap guard's lines.
internal/app/serveapp/swapguard.go 2 -- swap-guard lines scripts/mem_darwin.py and its test parse; their unit moves with the guard's own work
internal/guard/swapguard/sources.go 1 -- swap-guard lines scripts/mem_darwin.py and its test parse; their unit moves with the guard's own work
internal/guard/swapguard/swapguard.go 4 -- swap-guard lines scripts/mem_darwin.py and its test parse; their unit moves with the guard's own work
